# =============================================================================
# Paro environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- General ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- CORS (comma-separated list of allowed frontend origins) ---
CORS_ORIGINS=http://localhost:3000

# --- LLM provider selection ---
# Currently supported: nvidia
LLM_PROVIDER=nvidia

# --- NVIDIA NIM ---
# You are responsible for generating this key yourself via your NVIDIA
# Developer account. Paste it here - it is never sent to the frontend and
# never leaves the backend container.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# --- Agent / context management ---
MAX_CONTEXT_MESSAGES=20
MAX_CONTEXT_TOKENS=6000
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=2048

# --- Database (Postgres + pgvector) ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://paro:paro@postgres:5432/paro
DATABASE_ECHO=false

# Used only by docker-compose to initialize the Postgres container.
POSTGRES_USER=paro
POSTGRES_PASSWORD=paro
POSTGRES_DB=paro

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
REQUEST_MAX_BODY_BYTES=1000000
RATE_LIMIT_PER_MINUTE=60

# --- Frontend ---
# Base URL the browser uses to reach the API. In production this is
# typically the same origin, proxied by Nginx under /api.
NEXT_PUBLIC_API_URL=http://localhost:8000
